generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  restaurant
  cafe
  cloudKitchen
  pharmacy
  grocery
  superShop
  bakery
  retail
  electronics
  cosmetics
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

enum UserRole {
  owner
  admin
  platformAdmin
  manager
  cashier
  inventoryManager
  salesStaff
  accountant
  kitchenStaff
  pharmacist
  deliveryStaff
}

enum UserStatus {
  invited
  active
  suspended
}

enum SubscriptionStatus {
  trialing
  active
  pastDue
  cancelled
}

enum BillingInterval {
  monthly
  yearly
}

enum StorefrontStatus {
  draft
  published
}

enum SyncStatus {
  queued
  synced
  failed
}

enum StockMovementType {
  opening
  sale
  return
  purchase
  adjustment
  transferIn
  transferOut
  wastage
}

enum PurchaseStatus {
  draft
  received
  cancelled
}

enum PaymentStatus {
  pending
  captured
  failed
  refunded
}

enum TableStatus {
  available
  occupied
  reserved
}

enum KitchenStatus {
  new
  preparing
  ready
  served
}

model Tenant {
  id             String                @id @default(cuid())
  name           String
  businessType   BusinessType
  status         TenantStatus          @default(trial)
  phone          String
  email          String?
  plan           String                @default("Starter")
  vatRate        Decimal               @default(5) @db.Decimal(7, 3)
  serviceRate    Decimal               @default(0) @db.Decimal(7, 3)
  currency       String                @default("BDT")
  language       String                @default("Bangla + English")
  timezone       String                @default("Asia/Dhaka")
  receiptWidth   String                @default("80mm")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  branches       Branch[]
  modules        TenantModule[]
  users          User[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  orders         Order[]
  staff          StaffMember[]
  purchases      Purchase[]
  stockMovements InventoryMovement[]
  storefront     Storefront?
  subscription   Subscription?
  auditLogs      AuditLog[]
  restaurantTables RestaurantTable[]
  kitchenTickets KitchenTicket[]

  @@index([status])
}

model Branch {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  code              String
  address           String
  phone             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  orders            Order[]
  staff             StaffMember[]
  inventoryBalances InventoryBalance[]
  stockMovements    InventoryMovement[]
  purchases         Purchase[]
  restaurantTables  RestaurantTable[]
  kitchenTickets    KitchenTicket[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model User {
  id            String     @id @default(cuid())
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String
  role          UserRole   @default(cashier)
  status        UserStatus @default(active)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdOrders Order[]    @relation("OrderCreatedBy")
  auditLogs     AuditLog[]

  @@index([tenantId, status])
  @@index([branchId])
}

model TenantModule {
  tenantId    String
  moduleId    String
  enabled     Boolean  @default(true)
  activatedAt DateTime @default(now())
  expiresAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
  @@index([tenantId, enabled])
}

model Subscription {
  id                String             @id @default(cuid())
  tenantId          String             @unique
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planCode          String
  status            SubscriptionStatus @default(trialing)
  interval          BillingInterval    @default(monthly)
  amount            Decimal            @db.Decimal(12, 2)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  payments          SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  method         String
  reference      String?
  status         PaymentStatus @default(pending)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([subscriptionId, createdAt])
}

model Product {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  imageUrl          String?
  sku               String
  barcode           String?
  category          String
  brand             String?
  purchasePrice     Decimal            @default(0) @db.Decimal(12, 2)
  salePrice         Decimal            @db.Decimal(12, 2)
  discountPrice     Decimal?           @db.Decimal(12, 2)
  unit              String             @default("piece")
  stock             Decimal            @default(0) @db.Decimal(14, 3)
  minimumStock      Decimal            @default(0) @db.Decimal(14, 3)
  featured          Boolean            @default(false)
  active            Boolean            @default(true)
  attributes        Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItems        OrderItem[]
  inventoryBalances InventoryBalance[]
  stockMovements    InventoryMovement[]
  purchaseItems     PurchaseItem[]

  @@index([tenantId, category])
  @@index([tenantId, barcode])
  @@unique([tenantId, sku])
}

model InventoryBalance {
  id           String   @id @default(cuid())
  tenantId     String
  branchId     String
  productId    String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Decimal  @default(0) @db.Decimal(14, 3)
  minimumStock Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt    DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([tenantId, productId])
}

model InventoryMovement {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  balanceAfter  Decimal           @db.Decimal(14, 3)
  referenceType String?
  referenceId   String?
  note          String?
  createdById   String?
  createdAt     DateTime          @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([productId, createdAt])
}

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  phone        String
  email        String?
  address      String?
  payable      Decimal  @default(0) @db.Decimal(12, 2)
  lastPurchase Decimal  @default(0) @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  purchases    Purchase[]

  @@index([tenantId, active])
}

model Purchase {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseNo String
  invoiceNo  String?
  status     PurchaseStatus @default(draft)
  subtotal   Decimal        @db.Decimal(12, 2)
  paid       Decimal        @default(0) @db.Decimal(12, 2)
  due        Decimal        @default(0) @db.Decimal(12, 2)
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      PurchaseItem[]

  @@unique([tenantId, purchaseNo])
  @@index([tenantId, createdAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Decimal  @db.Decimal(14, 3)
  unitCost   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  batchNo    String?
  expiryDate DateTime?
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  address       String?
  totalSpend    Decimal  @default(0) @db.Decimal(12, 2)
  due           Decimal  @default(0) @db.Decimal(12, 2)
  loyaltyPoints Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@unique([tenantId, phone])
  @@index([tenantId, active])
}

model Order {
  id            String        @id @default(cuid())
  tenantId      String
  branchId      String
  customerId    String?
  createdById   String?
  tableId       String?
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderNo       String
  source        String        @default("pos")
  orderType     String        @default("counter")
  status        String
  paymentMethod String
  paymentStatus PaymentStatus @default(captured)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  serviceCharge Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  syncStatus    SyncStatus    @default(synced)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  payments      OrderPayment[]
  kitchenTicket KitchenTicket?

  @@unique([tenantId, orderNo])
  @@index([tenantId, branchId, createdAt])
  @@index([tableId])
}

model RestaurantTable {
  id        String      @id @default(cuid())
  tenantId  String
  branchId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int         @default(2)
  status    TableStatus @default(available)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  orders    Order[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, status])
}

model KitchenTicket {
  id        String        @id @default(cuid())
  tenantId  String
  branchId  String
  orderId   String        @unique
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    KitchenStatus @default(new)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId, branchId, status, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  quantity  Decimal  @db.Decimal(14, 3)
  unitPrice Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  note      String?
}

model OrderPayment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    String
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  status    PaymentStatus @default(captured)
  createdAt DateTime      @default(now())

  @@index([orderId])
}

model StaffMember {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employeeNo String
  name       String
  phone      String?
  role       String
  shift      String
  salary     Decimal  @default(0) @db.Decimal(12, 2)
  status     String   @default("Present")
  joinedAt   DateTime @default(now())
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, employeeNo])
  @@index([tenantId, active])
}

model Storefront {
  id              String           @id @default(cuid())
  tenantId        String           @unique
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug            String           @unique
  publishedSlug   String?          @unique
  publishedConfig Json?
  customDomain    String?          @unique
  logoUrl         String?
  heroTitle       String
  tagline         String
  status          StorefrontStatus @default(draft)
  theme           String
  primaryColor    String           @default("#146c5c")
  deliveryEnabled Boolean          @default(true)
  pickupEnabled   Boolean          @default(true)
  sections        Json             @default("[]")
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}
